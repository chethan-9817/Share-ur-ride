# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────
# Production: a real PostgreSQL URL, e.g. postgres://arriveshare:secret@localhost:5432/arriveshare
# Local dev without Docker: embedded Postgres (PGlite) persisted to a folder
DATABASE_URL=pglite://.pglite/arriveshare

# ── Auth ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5

# ── Pricing (INR) ─────────────────────────────────────────
BASE_FARE=50
RATE_PER_KM=12
MIN_FARE=80
FULL_CAB_BONUS_PCT=0.10
COMMISSION_PCT=0.15

# ── Matching & dispatch ───────────────────────────────────
MAX_DETOUR_PCT=0.30
MAX_DETOUR_KM=6
CAB_CAPACITY=4
LUGGAGE_CAPACITY=4
MATCH_HORIZON_MIN=180
ACCEPT_WINDOW_SEC=120
OFFER_TIMEOUT_SEC=30
FEMALE_DRIVER_PRIORITY_SEC=120
NO_SHOW_WAIT_MIN=5
SCHEDULER_INTERVAL_SEC=10

# ── Safety ────────────────────────────────────────────────
CHECK_IN_TIMEOUT_SEC=120
SHARE_LINK_TTL_HOURS=12

# ── Routing ───────────────────────────────────────────────
OSRM_ENABLED=true
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=3000
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ── Email (leave SMTP_HOST empty to log emails to the console) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ArriveShare <no-reply@arriveshare.app>"

# ── Demo ──────────────────────────────────────────────────
# Enables one-tap demo logins, on-screen OTPs and simulated co-riders/drivers.
DEMO_MODE=true
SIMULATOR_ENABLED=true

# Optional: Redis for multi-instance Socket.IO fan-out
REDIS_URL=
