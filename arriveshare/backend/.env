# ArriveShare Environment Configuration
# Copy this file as .env and adjust values as needed

DATABASE_URL=sqlite:///./arriveshare.db
SECRET_KEY=arriveshare-dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fare configuration (INR)
BASE_FARE=50
RATE_PER_KM=12

# Matching engine configuration
TIME_WINDOW_MINUTES=20
DETOUR_THRESHOLD_KM=3
MAX_DETOUR_KM=5
CAB_CAPACITY=4

# OSRM public demo server (no API key needed)
OSRM_BASE_URL=https://router.project-osrm.org

# SMTP Email Configuration (Set SMTP_ENABLED=true and fill credentials to send live emails)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@arriveshare.com
SMTP_FROM_NAME=ArriveShare
SMTP_USE_TLS=true
